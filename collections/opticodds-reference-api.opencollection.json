{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpticOdds Sports Betting Fixtures Reference API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reference",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List sports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opticodds.com/api/v3/sports"
          },
          "docs": "Returns the catalogue of supported sports."
        },
        {
          "info": {
            "name": "List currently active sports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opticodds.com/api/v3/sports/active"
          },
          "docs": "List currently active sports"
        },
        {
          "info": {
            "name": "List leagues",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opticodds.com/api/v3/leagues",
            "params": [
              {
                "name": "sport",
                "value": "",
                "type": "query",
                "description": "Sport slug (e.g. `basketball`)."
              }
            ]
          },
          "docs": "List leagues"
        },
        {
          "info": {
            "name": "List active leagues",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opticodds.com/api/v3/leagues/active"
          },
          "docs": "List active leagues"
        },
        {
          "info": {
            "name": "List sportsbooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opticodds.com/api/v3/sportsbooks"
          },
          "docs": "List sportsbooks"
        },
        {
          "info": {
            "name": "List market types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opticodds.com/api/v3/market-types",
            "params": [
              {
                "name": "sport",
                "value": "",
                "type": "query",
                "description": "Sport slug (e.g. `basketball`)."
              }
            ]
          },
          "docs": "List market types"
        },
        {
          "info": {
            "name": "List markets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opticodds.com/api/v3/markets"
          },
          "docs": "List markets"
        }
      ]
    }
  ],
  "bundled": true
}